  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
};

const passwordHint = {
  color: "#475569",
  fontSize: "10px",
  marginBottom: "8px",
};

const inputWrap = {
  position: "relative",
  marginBottom: "20px",
};

const inputIcon = {
  position: "absolute",
  left: "14px",
  top: "50%",
  transform: "translateY(-50%)",
  fontSize: "16px",
  opacity: 0.75,
  zIndex: 2,
};

const inputWithIconStyle = {
  width: "100%",
  height: "52px",
  boxSizing: "border-box",
  padding: "0 15px 0 44px",
  borderRadius: "13px",
  border: "1px solid #263b33",
  outline: "none",
  background: "#0c1915",
  color: "#ffffff",
  fontSize: "14px",
};

const passwordButtonStyle = {
  position: "absolute",
  right: "8px",
  top: "50%",
  transform: "translateY(-50%)",
  border: "none",
  background: "transparent",
  color: "#94a3b8",
  padding: "8px",
  cursor: "pointer",
  fontSize: "16px",
};

const buttonStyle = {
  width: "100%",
  minHeight: "52px",
  border: "none",
  borderRadius: "13px",
  background: "linear-gradient(135deg, #22c55e, #16a34a)",
  color: "#04130b",
  fontSize: "14px",
  fontWeight: 900,
  letterSpacing: "0.2px",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  gap: "10px",
  boxShadow: "0 12px 28px rgba(34,197,94,0.20)",
};

