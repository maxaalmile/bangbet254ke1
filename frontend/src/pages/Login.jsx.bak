  display: "flex",
  alignItems: "center",
  gap: "10px",
  margin: "25px 0 18px",
};

const dividerLine = {
  flex: 1,
  height: "1px",
  background: "#20332c",
};

const dividerText = {
  color: "#64748b",
  fontSize: "11px",
  whiteSpace: "nowrap",
};

const secondaryButtonStyle = {
  width: "100%",
  minHeight: "50px",
  boxSizing: "border-box",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  borderRadius: "13px",
  border: "1px solid #294238",
  background: "rgba(255,255,255,0.02)",
  color: "#e2e8f0",
  textDecoration: "none",
  fontSize: "14px",
  fontWeight: 800,
};

const secureText = {
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  gap: "7px",
  color: "#64748b",
  fontSize: "10px",
  marginTop: "20px",
  textAlign: "center",
};
