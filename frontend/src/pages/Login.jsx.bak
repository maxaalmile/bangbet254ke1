  margin: 0,
  color: "#ffffff",
  fontSize: "31px",
  lineHeight: 1.15,
  fontWeight: 900,
  letterSpacing: "-1px",
};

const subtitleStyle = {
  margin: "10px 0 0",
  color: "#94a3b8",
  fontSize: "14px",
  lineHeight: 1.6,
};

const errorStyle = {
  display: "flex",
  alignItems: "center",
  gap: "10px",
  padding: "12px 14px",
  marginBottom: "20px",
  borderRadius: "12px",
  background: "rgba(239,68,68,0.10)",
  border: "1px solid rgba(239,68,68,0.22)",
  color: "#fca5a5",
  fontSize: "13px",
  fontWeight: 600,
};

const errorIcon = {
  width: "22px",
  height: "22px",
  borderRadius: "50%",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  background: "rgba(239,68,68,0.18)",
  color: "#f87171",
  fontWeight: 900,
  flexShrink: 0,
};

const labelStyle = {
  display: "block",
  color: "#e2e8f0",
  fontSize: "13px",
  fontWeight: 700,
  marginBottom: "8px",
};

