import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useAuth } from "../context/AuthContext";

export default function Login() {
  const navigate = useNavigate();
  const { login } = useAuth();

  const [form, setForm] = useState({
    phone: "",
    password: "",
  });

  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [showPassword, setShowPassword] = useState(false);

  function handleChange(event) {
    setForm({
      ...form,
      [event.target.name]: event.target.value,
    });
  }

  async function handleSubmit(event) {
    event.preventDefault();
    setError("");

    if (!form.phone.trim()) {
      setError("Please enter your phone number.");
      return;
    }

    if (!form.password) {
      setError("Please enter your password.");
      return;
    }

    setLoading(true);

    try {
      const user = await login({
        phone: form.phone.trim(),
        password: form.password,
      });

      if (user.is_admin) {
        navigate("/admin");
      } else {
        navigate("/dashboard");
      }
    } catch (err) {
      setError(
        err.response?.data?.detail ||
          err.message ||
          "Login failed. Please check your phone number and password."
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <div style={pageStyle}>
      <div style={glowTop}></div>
      <div style={glowBottom}></div>

      <main style={wrapperStyle}>
        <section style={cardStyle}>
          <div style={brandWrap}>
            <div style={brandIcon}>B</div>

            <div>
              <div style={brandName}>BangBet254</div>
              <div style={brandTagline}>PLAY • BET • WIN</div>
            </div>
          </div>

          <div style={headingWrap}>
            <div style={welcomeBadge}>
              <span>👋</span>
              Welcome back
            </div>

            <h1 style={headingStyle}>Login to your account</h1>

            <p style={subtitleStyle}>
              Continue where you left off and enjoy the action.
            </p>
          </div>

          {error && (
            <div style={errorStyle}>
              <span style={errorIcon}>!</span>
              <span>{error}</span>
            </div>
          )}

          <form onSubmit={handleSubmit}>
            <label htmlFor="login-phone" style={labelStyle}>
              Phone number
            </label>

            <div style={inputWrap}>
              <span style={inputIcon}>📱</span>

              <input
                id="login-phone"
                type="tel"
                name="phone"
                value={form.phone}
                onChange={handleChange}
                placeholder="254700000000"
                required
                autoComplete="tel"
                style={inputWithIconStyle}
              />
            </div>

            <div style={passwordLabelRow}>
              <label htmlFor="login-password" style={labelStyle}>
                Password
              </label>

              <span style={passwordHint}>Keep it secure</span>
            </div>

            <div style={inputWrap}>
              <span style={inputIcon}>🔒</span>

              <input
                id="login-password"
                type={showPassword ? "text" : "password"}
                name="password"
                value={form.password}
                onChange={handleChange}
                placeholder="Enter your password"
                required
                autoComplete="current-password"
                style={{
                  ...inputWithIconStyle,
                  paddingRight: "52px",
                }}
              />

              <button
                type="button"
                onClick={() => setShowPassword(!showPassword)}
                style={passwordButtonStyle}
                aria-label={
                  showPassword ? "Hide password" : "Show password"
                }
              >
                {showPassword ? "🙈" : "👁"}
              </button>
            </div>

            <button
              type="submit"
              disabled={loading}
              style={{
                ...buttonStyle,
                opacity: loading ? 0.7 : 1,
                cursor: loading ? "not-allowed" : "pointer",
              }}
            >
              {loading ? (
                <>
                  <span style={spinnerStyle}></span>
                  Logging in...
                </>
              ) : (
                <>
                  Login
                  <span style={arrowStyle}>→</span>
                </>
              )}
            </button>
          </form>

          <div style={dividerStyle}>
            <span style={dividerLine}></span>
            <span style={dividerText}>New to BangBet254?</span>
            <span style={dividerLine}></span>
          </div>

          <Link to="/register" style={secondaryButtonStyle}>
            Create a new account
          </Link>

          <div style={secureText}>
            <span>🔒</span>
            <span>Secure login • Your information is protected</span>
          </div>
        </section>
      </main>
    </div>
  );
}

const pageStyle = {
  minHeight: "100vh",
  position: "relative",
  overflow: "hidden",
  background:
    "radial-gradient(circle at top left, #123b2d 0%, #071c16 30%, #050b0a 65%, #030605 100%)",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  padding: "30px 16px",
  boxSizing: "border-box",
  fontFamily:
    "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
};

const glowTop = {
  position: "absolute",
  width: "420px",
  height: "420px",
  borderRadius: "50%",
  background: "rgba(35, 197, 94, 0.10)",
  filter: "blur(80px)",
  top: "-180px",
  right: "-120px",
};

const glowBottom = {
  position: "absolute",
  width: "360px",
  height: "360px",
  borderRadius: "50%",
  background: "rgba(16, 185, 129, 0.08)",
  filter: "blur(80px)",
  bottom: "-180px",
  left: "-120px",
};

const wrapperStyle = {
  width: "100%",
  maxWidth: "470px",
  position: "relative",
  zIndex: 2,
};

const cardStyle = {
  width: "100%",
  boxSizing: "border-box",
  padding: "34px 32px",
  borderRadius: "24px",
  background: "rgba(9, 20, 17, 0.94)",
  border: "1px solid rgba(74, 222, 128, 0.14)",
  boxShadow:
    "0 30px 80px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.03)",
  backdropFilter: "blur(18px)",
};

const brandWrap = {
  display: "flex",
  alignItems: "center",
  gap: "12px",
  marginBottom: "27px",
};

const brandIcon = {
  width: "45px",
  height: "45px",
  borderRadius: "13px",
  display: "flex",
  alignItems: "center",
  justifyContent: "center",
  background: "linear-gradient(135deg, #22c55e, #16a34a)",
  color: "#04130b",
  fontSize: "24px",
  fontWeight: 900,
  boxShadow: "0 10px 25px rgba(34,197,94,0.22)",
};

const brandName = {
  color: "#ffffff",
  fontSize: "20px",
  fontWeight: 900,
  letterSpacing: "-0.4px",
};

const brandTagline = {
  color: "#4ade80",
  fontSize: "9px",
  fontWeight: 800,
  letterSpacing: "2px",
  marginTop: "2px",
};

const headingWrap = {
  marginBottom: "26px",
};

const welcomeBadge = {
  display: "inline-flex",
  alignItems: "center",
  gap: "7px",
  padding: "6px 10px",
  borderRadius: "20px",
  background: "rgba(34,197,94,0.08)",
  border: "1px solid rgba(34,197,94,0.14)",
  color: "#4ade80",
  fontSize: "11px",
  fontWeight: 800,
  marginBottom: "12px",
};

